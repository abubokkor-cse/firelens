# Copy to backend/.env for local development. Never commit the real .env.

# NASA FIRMS MAP_KEY — free at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=your_firms_map_key

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# Optional: run from a published archive instead of local data/ (e.g. https://<bucket-public-url>/archive)
# FIRELENS_ARCHIVE_URL=

# Only for scripts/publish_r2.sh (Cloudflare R2, S3-compatible API)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=firelens
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Fire alerts (optional)
RESEND_API_KEY=
ALERTS_FROM="FireLens Alerts <alerts@your-domain.com>"
ALERTS_RUN_TOKEN=
ALERTS_STORE=local
